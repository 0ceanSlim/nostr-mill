{
  "name": "nostr-mill",
  "version": "1.6.0-beta.0",
  "description": "MILL — Multi-Interface Login Layer. Zero-dependency Web Component for Nostr account access. Supports NIP-07, NIP-46, NIP-55, private key, read-only, and new keypair generation.",
  "author": "0ceanslim <oceanslim@gmx.com>",
  "license": "MIT",
  "homepage": "https://github.com/0ceanslim/nostr-mill#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0ceanslim/nostr-mill.git"
  },
  "bugs": {
    "url": "https://github.com/0ceanslim/nostr-mill/issues"
  },
  "keywords": [
    "nostr",
    "nip-07",
    "nip-46",
    "nip-55",
    "web-component",
    "signer",
    "login",
    "identity",
    "bitcoin",
    "decentralized"
  ],
  "type": "module",
  "main": "./dist/mill.cjs.js",
  "module": "./dist/mill.esm.js",
  "browser": "./dist/mill.umd.js",
  "unpkg": "./dist/mill.umd.min.js",
  "jsdelivr": "./dist/mill.umd.min.js",
  "exports": {
    ".": {
      "import": "./dist/mill.esm.js",
      "require": "./dist/mill.cjs.js",
      "browser": "./dist/mill.umd.js",
      "default": "./dist/mill.esm.js"
    },
    "./themes": {
      "import": "./dist/themes.js",
      "default": "./dist/themes.js"
    }
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "nostr-tools": ">=2.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "nostr-tools": "^2.7.0",
    "rollup": "^4.0.0"
  },
  "sideEffects": [
    "./src/mill-core.js",
    "./dist/mill.umd.js",
    "./dist/mill.umd.min.js"
  ],
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
